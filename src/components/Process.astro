---
import { processSteps } from '../data/site';
import SectionHeading from './SectionHeading.astro';
---
<section id="process" class="process section-pad"><SectionHeading number="05" label="HOW THE WORK GETS DONE"/><div class="process-layout"><div><h2>FIRST THE<br/><span class="muted-heading">INSPECTION.</span></h2><p class="process-intro">Paint differs from car to car. The detailer checks its condition before choosing a polish, coating or film.</p><span class="small-note">A FICTIONAL STUDIO CONCEPT</span></div><ol class="process-list">{processSteps.map((step,i) => <li><span>0{i+1}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol></div></section>
